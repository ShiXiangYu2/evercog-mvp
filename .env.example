# ==================== 数据库 ====================
# Prisma 数据库连接字符串
# 开发环境：使用 SQLite
DATABASE_URL="file:./dev.db"
# 生产环境：使用 PostgreSQL（Railway 等平台会自动设置）
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ==================== JWT 认证 ====================
# JWT 签名密钥（生产环境必须使用强随机字符串，至少 32 位）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-string-in-production"

# JWT Token 有效期（支持: 24h, 7d, 30d）
JWT_EXPIRES_IN="24h"

# ==================== LLM 配置 ====================
# LLM Provider 类型: mock | deepseek | openai
# 开发环境可使用 mock，生产环境必须配置真实 API
LLM_PROVIDER="mock"

# DeepSeek 配置（推荐，成本低、中文能力强）
# 获取 API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# OpenAI 配置（可选）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# LLM 超时配置（毫秒）
LLM_TIMEOUT="30000"

# 超时后是否降级到 Mock 模式
LLM_FALLBACK_TO_MOCK="true"

# ==================== 应用配置 ====================
# 应用运行环境: development | production | test
NODE_ENV="development"

# 应用端口（生产环境由平台分配，开发环境默认 3000）
PORT=3000

# ==================== CORS 配置 ====================
# 允许的源（生产环境设置为你的域名）
CORS_ORIGIN="http://localhost:3000"

# 允许的方法
CORS_METHODS="GET,POST,PUT,DELETE,OPTIONS"

# 是否支持凭证（Cookie）
CORS_CREDENTIALS="true"

# ==================== Rate Limiting ====================
# 匿名用户限制（次/分钟）
RATE_LIMIT_ANONYMOUS="60"

# 认证用户限制（次/分钟）
RATE_LIMIT_AUTHENTICATED="120"

# 登录接口限制（次/分钟）
RATE_LIMIT_LOGIN="10"

# ==================== 企业微信配置（可选） ====================
# 企业 ID
WECOM_CORP_ID=""

# 应用 Secret
WECOM_CORP_SECRET=""

# 应用 AgentId
WECOM_AGENT_ID=""
