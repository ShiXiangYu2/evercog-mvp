# ==================== 数据库 ====================
# Prisma 数据库连接字符串
DATABASE_URL="file:./dev.db"

# ==================== JWT 认证 ====================
# JWT 签名密钥（生产环境请使用强随机字符串，至少 32 位）
JWT_SECRET="change-this-to-a-strong-random-string-in-production"

# JWT Token 有效期（支持: 24h, 7d, 30d）
JWT_EXPIRES_IN="24h"

# ==================== LLM 配置 ====================
# LLM Provider 类型: mock | deepseek | openai
LLM_PROVIDER="mock"

# DeepSeek 配置（推荐，成本低、中文能力强）
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# OpenAI 配置（可选）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ==================== 应用配置 ====================
# 应用运行环境: development | production | test
NODE_ENV="development"

# 应用端口（开发服务器）
PORT=3000
