// 恒识 Evercog MVP 数据模型
// 生成日期：2026-06-11

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 基础模型 ====================

// 部门
model Department {
  id          String   @id @default(cuid())
  name        String   // 部门名称：销售部、客服部、运营部、财务部、AI 信息部
  description String?  // 部门描述
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]

  @@map("departments")
}

// 用户
model User {
  id           String   @id @default(cuid())
  name         String   // 用户姓名
  email        String?  // 邮箱（演示模式可选）
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  role         String   // 角色：sales, customer_service, operations, finance, ai_info, admin, mentor, trainee
  status       String   @default("active") // active, inactive
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submittedLinks     PolicyLink[]     @relation("Submitter")
  generatedBriefs    PolicyBrief[]    @relation("Generator")
  pushedRecords      PushRecord[]     @relation("Pusher")
  createdCards       KnowledgeCard[]  @relation("Creator")
  reviewedCards      KnowledgeCard[]  @relation("Reviewer")
  experienceQueries  ExperienceQuery[] @relation("Caller")
  createdTasks       SOPTask[]        @relation("Mentor")
  assignedTasks      SOPTask[]        @relation("Trainee")
  submissions        SOPSubmission[]  @relation("Submitter")
  reviewedSubmissions SOPSubmission[] @relation("Reviewer")
  auditLogs          AuditLog[]
  assignedAgentTasks AgentTask[] @relation("AgentTaskAssignee")
  createdAgentTasks  AgentTask[] @relation("AgentTaskCreator")

  @@map("users")
}

// ==================== 索引定义 ====================

// ==================== 政策情报模块 ====================

// 政策链接
model PolicyLink {
  id             String   @id @default(cuid())
  url            String   // 政策链接 URL
  title          String?  // 政策标题
  source         String?  // 来源网站
  submitterId    String
  submitter      User     @relation("Submitter", fields: [submitterId], references: [id])
  departmentId   String?  // 适用部门
  customerType   String?  // 适用客户类型：restaurant, retail, store, advertising, startup, individual
  status         String   @default("submitted") // submitted, collected, brief_generated, reviewed, pushed, archived
  collectedAt    DateTime? // 内容采集时间
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brief          PolicyBrief?
  pushRecords    PushRecord[]

  @@map("policy_links")

  @@index([status])
  @@index([submitterId])
  @@index([customerType])
  @@index([createdAt])
}

// 政策简报
model PolicyBrief {
  id              String   @id @default(cuid())
  policyLinkId    String   @unique
  policyLink      PolicyLink @relation(fields: [policyLinkId], references: [id])
  title           String   // 简报标题
  summary         String   // 摘要
  applicableTo    String?  // 适用对象（JSON 数组）
  keyClauses      String?  // 关键条款
  actionSuggestions String? // 行动建议
  riskReminders   String?  // 风险提醒
  sourceUrl       String?  // 来源链接
  generatorId     String
  generator       User     @relation("Generator", fields: [generatorId], references: [id])
  reviewStatus    String   @default("draft") // draft, pending_review, reviewed, rejected
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pushRecords     PushRecord[]

  @@map("policy_briefs")

  @@index([reviewStatus])
  @@index([generatorId])
  @@index([createdAt])
}

// 模拟企微推送记录
model PushRecord {
  id              String   @id @default(cuid())
  policyBriefId   String
  policyBrief     PolicyBrief @relation(fields: [policyBriefId], references: [id])
  policyLinkId    String?
  policyLink      PolicyLink? @relation(fields: [policyLinkId], references: [id])
  channel         String   @default("wecom") // wecom, email, sms
  targetType      String   // department, role, user
  targetId        String?  // 目标 ID
  targetName      String?  // 目标名称（快照）
  status          String   @default("pending") // pending, sent, delivered, failed
  readStatus      String   @default("unread") // unread, read
  payloadSnapshot String?  // 推送内容快照（JSON）
  pusherId        String
  pusher          User     @relation("Pusher", fields: [pusherId], references: [id])
  sentAt          DateTime?
  readAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("push_records")

  @@index([policyBriefId])
  @@index([pusherId])
  @@index([status])
  @@index([readStatus])
  @@index([createdAt])
}

// ==================== 知识库模块 ====================

// 知识卡
model KnowledgeCard {
  id              String   @id @default(cuid())
  title           String   // 知识卡标题
  category        String   // 分类：data_checklist, tax_process, risk_reminder, service_boundary, faq, experience
  tags            String?  // 标签（JSON 数组）
  content         String   // 知识内容（Markdown）
  departmentId    String?  // 所属部门
  customerType    String?  // 适用客户类型
  source          String?  // 来源
  riskNotes       String?  // 风险提示
  visibilityScope String   @default("department") // department, role, public
  status          String   @default("draft") // draft, pending_review, published, rejected, archived
  version         Int      @default(1)
  creatorId       String
  creator         User     @relation("Creator", fields: [creatorId], references: [id])
  reviewerId      String?
  reviewer        User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("knowledge_cards")

  @@index([status])
  @@index([category])
  @@index([creatorId])
  @@index([departmentId])
  @@index([visibilityScope])
  @@index([createdAt])
}

// ==================== 经验调用模块 ====================

// 经验调用
model ExperienceQuery {
  id              String   @id @default(cuid())
  question        String   // 用户输入的问题
  callerId        String
  caller          User     @relation("Caller", fields: [callerId], references: [id])
  retrievedCards  String?  // 检索到的知识卡 ID 列表（JSON）
  generatedReply  String?  // 生成的回复建议（JSON）
  policyExplanation String? // 政策解释
  serviceOpportunity String? // 服务机会
  salesScript     String?  // 销售话术
  riskReminder    String?  // 风险提醒
  citedSources    String?  // 引用来源（JSON 数组）
  status          String   @default("pending") // pending, generated, reviewed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("experience_queries")

  @@index([callerId])
  @@index([status])
  @@index([createdAt])
}

// ==================== SOP 训练模块 ====================

// SOP 训练任务
model SOPTask {
  id              String   @id @default(cuid())
  title           String   // 任务标题
  description     String?  // 任务描述
  template        String?  // SOP 模板（Markdown）
  requirements    String?  // 训练要求
  mentorId        String
  mentor          User     @relation("Mentor", fields: [mentorId], references: [id])
  traineeId       String
  trainee         User     @relation("Trainee", fields: [traineeId], references: [id])
  dueDate         DateTime? // 截止时间
  status          String   @default("assigned") // assigned, in_progress, submitted, reviewed, completed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     SOPSubmission[]

  @@map("sop_tasks")

  @@index([mentorId])
  @@index([traineeId])
  @@index([status])
  @@index([createdAt])
}

// SOP 提交
model SOPSubmission {
  id              String   @id @default(cuid())
  taskId          String
  task            SOPTask  @relation(fields: [taskId], references: [id])
  content         String   // 提交的 SOP 内容（Markdown）
  submitterId     String
  submitter       User     @relation("Submitter", fields: [submitterId], references: [id])
  inspectionReport String? // 检查报告（JSON）
  completeness    Float?   // 完整性评分
  missingSteps    String?  // 遗漏步骤
  riskPoints      String?  // 风险点
  executability   Float?   // 可执行性评分
  reviewerId      String?
  reviewer        User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewComment   String?  // 审核意见
  status          String   @default("submitted") // submitted, reviewing, approved, rejected, revision_required
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sop_submissions")
}

// ==================== 审计日志 ====================

// 审计日志
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String   // 操作类型：create, edit, review, publish, reject, query, generate, push, approve
  entityType  String   // 实体类型：policy_link, policy_brief, knowledge_card, experience_query, sop_task, sop_submission
  entityId    String?  // 实体 ID
  details     String?  // 操作详情（JSON）
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
}

// ==================== Agent 任务模块（P0） ====================

// Agent 任务
model AgentTask {
  id          String   @id @default(cuid())
  type        String   // 任务类型：knowledge_review, sop_review, brief_generation, gap_fill
  title       String   // 任务标题
  description String?  // 任务描述
  status      String   @default("pending") // 状态：pending, in_progress, completed, failed
  priority    String   @default("medium") // 优先级：high, medium, low
  assignedTo  String?  // 分配给（用户 ID）
  assignedToUser User? @relation("AgentTaskAssignee", fields: [assignedTo], references: [id])
  createdBy   String
  createdByUser User @relation("AgentTaskCreator", fields: [createdBy], references: [id])
  dueDate     DateTime? // 截止时间
  completedAt DateTime? // 完成时间
  result      String?  // 任务结果（JSON）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agent_tasks")

  @@index([status])
  @@index([assignedTo])
  @@index([priority])
  @@index([createdAt])
}

// ==================== 知识缺口模块（P0） ====================

// 知识缺口
model KnowledgeGap {
  id              String   @id @default(cuid())
  question        String   // 被问的问题
  department      String?  // 所属部门
  topic           String?  // 主题分类
  frequency       Int      @default(1) // 被问次数
  priority        String   @default("low") // 优先级：high (20+), medium (10-19), low (<10)
  status          String   @default("pending") // 状态：pending, in_progress, resolved, ignored
  suggestedAction String?  // 建议操作：create_card, update_card, rewrite_card
  resolvedBy      String?  // 解决人（用户 ID）
  resolvedAt      DateTime? // 解决时间
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("knowledge_gaps")

  @@index([status])
  @@index([priority])
  @@index([frequency])
}

// ==================== 问答热力图模块（P1） ====================

// 问答热力图统计
model QuestionHeatMap {
  id          String   @id @default(cuid())
  department  String   // 部门
  topic       String   // 主题
  frequency   Int      @default(0) // 问答次数
  timeRange   String   @default("this_week") // 时间范围：today, this_week, this_month
  calculatedAt DateTime @default(now()) // 计算时间

  @@map("question_heatmaps")
}

// ==================== 质量监控模块（P1） ====================

// 质量监控指标
model QualityMetrics {
  id          String   @id @default(cuid())
  metricType  String   // 指标类型：coverage, citation_rate, satisfaction, outdated_rate
  value       Float    // 指标值
  target      Float    // 目标值
  department  String?  // 部门（可选，null 表示全公司）
  calculatedAt DateTime @default(now()) // 计算时间

  @@map("quality_metrics")
}
